# Conexión a PostgreSQL (cambia TU_CLAVE por tu contraseña)
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/ventanas_roco
PORT=8080

# Clave para firmar los tokens (JWT). Usa un texto largo y al azar, distinto en cada ambiente.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Solo en internet (Render, Railway, etc.): poner true si el servicio de base de datos exige SSL
# DATABASE_SSL=true

# Opcional: datos para el script del primer administrador (npm run admin:crear).
# Si no los pones, el script los pregunta. Lo más seguro es NO guardar la contraseña aquí.
# ADMIN_NOMBRE=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
